# Files here are repo/community governance, not skill content. export-ignore keeps
# them out of `git archive` output -- i.e. GitHub's "Download ZIP", tarball/zipball
# release URLs, and the beamer-to-ltx-talk-vX.Y.Z.zip built by
# .github/workflows/release.yml (which uses `git archive`) -- while still living
# in the repo for anyone browsing or cloning it on GitHub.

.github/            export-ignore
.github/**          export-ignore
.gitattributes      export-ignore
.gitignore          export-ignore
CODE_OF_CONDUCT.md  export-ignore
CONTRIBUTING.md     export-ignore
SECURITY.md         export-ignore
tests/              export-ignore
tests/**            export-ignore
